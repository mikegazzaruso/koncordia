# Copy to /home/mike/apps/koncordia/.env on forge. Never commit the real file.
KONCORDIA_PUBLIC_URL=https://api.koncordia.dev
KONCORDIA_SITE_URL=https://koncordia.dev
KONCORDIA_ALLOWED_HOSTS=api.koncordia.dev
# >= 16 random chars: openssl rand -base64 32
KONCORDIA_SECRET=
# GitHub OAuth App (callback https://api.koncordia.dev/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# KONCORDIA_QUOTAS=0   # uncomment to disable early-access limits
